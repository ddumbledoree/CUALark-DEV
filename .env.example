# OpenAI-compatible VLM provider. Do not commit real secrets in .env.
VLM_BASE_URL=
VLM_API_KEY=
VLM_MODEL=
VLM_PROVIDER_NAME=volcengine-ark

# Phase 1 defaults. Use mock until desktop/VLM credentials are intentionally enabled.
CUA_OPERATOR=mock
CUA_TRACE_DIR=traces

# Phase 2 desktop operator settings. Keep empty unless intentionally running real GUI actions.
CUA_SCREEN_WIDTH=2048
CUA_SCREEN_HEIGHT=1152
# Default focus mode activates Feishu/Lark by window title before each real desktop action.
CUA_FEISHU_FOCUS_MODE=app-activate
CUA_FEISHU_WINDOW_TITLES=飞书,Feishu,Lark
CUA_FEISHU_PROCESS_NAMES=Feishu,Lark
CUA_FEISHU_CLASS_NAMES=Chrome_WidgetWin_1
# Optional: used to relaunch/restore Feishu when only an offscreen/minimized window is present.
# Example: C:\Users\<you>\AppData\Local\Lark\app\Lark.exe
CUA_FEISHU_EXE=
# Optional fallback for CUA_FEISHU_FOCUS_MODE=taskbar or when app activation fails.
# Phase 0 example on this machine was around [0.34,0.98,0.34,0.98], but taskbar layout can drift.
CUA_FEISHU_FOCUS_BOX=
CUA_POST_ACTION_DELAY_MS=300

# Phase 2 observe-only agent loop defaults. Keep actions restricted before real desktop tests.
CUA_AGENT_MAX_STEPS=3
CUA_AGENT_ALLOWED_ACTIONS=wait,finished

# VLM Locator settings (agent-v2). Controls how the hybrid agent loop handles VLM-based element location.
CUA_LOCATOR_MAX_RETRIES=2
CUA_LOCATOR_CONFIDENCE_THRESHOLD=0.5

# Phase 3 API evaluator settings. lark-cli keeps its own auth/config; do not commit tokens.
LARK_CLI_BIN=node_modules\\@larksuite\\cli\\bin\\lark-cli.exe
CUA_EVALUATOR_TIMEOUT_MS=10000
